{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ai-gens/packages/main/schemas/package-release.schema.json",
  "title": "Published package release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "package",
    "version",
    "publishedAt",
    "prerelease",
    "release",
    "changelog",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "package": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "prerelease": {
      "type": "boolean"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "url"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "changelog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "content"
      ],
      "properties": {
        "format": {
          "const": "markdown"
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "os",
          "arch",
          "size",
          "sha256",
          "downloadUrl"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "os": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "arch": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "downloadUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
