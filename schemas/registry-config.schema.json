{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ai-gens/packages/main/schemas/registry-config.schema.json",
  "title": "Package registry configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packages"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packages": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9]+(?:[._-][a-z0-9]+)*$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publishPrereleases",
            "assets"
          ],
          "properties": {
            "publishPrereleases": {
              "type": "boolean"
            },
            "assets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "template",
                  "os",
                  "arch"
                ],
                "properties": {
                  "template": {
                    "type": "string",
                    "pattern": "^[^/\\\\]*\\{version\\}[^/\\\\]*$"
                  },
                  "os": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
                  },
                  "arch": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
